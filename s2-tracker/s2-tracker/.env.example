# Anthropic API key, 必填
# 在 https://console.anthropic.com/settings/keys 获取
ANTHROPIC_API_KEY=sk-ant-xxx

# 可选: Claude 模型选择
# claude-haiku-4-5-20251001    便宜快, 适合批量解析 transcript
# claude-opus-4-7              准确度更高, 用于复杂判断
CLAUDE_MODEL_CHEAP=claude-haiku-4-5-20251001
CLAUDE_MODEL_SMART=claude-opus-4-7
